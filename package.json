{
  "name": "medlabel",
  "version": "0.1.0",
  "private": true,
  "description": "Chrome extension shell for medication infusion labels from HIS patient data.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prettier": "prettier \"**/*.{md,html,json,css,ts}\" --write",
    "lookup": "tsx scripts/lookup-ma-ho-so.ts",
    "test:ui": "tsx scripts/test-ui-server.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "dotenv": "^18.0.3",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.2.0",
    "@eslint/js": "^9.19.0",
    "@types/chrome": "^0.0.287",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "eslint": "^9.19.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.4.1",
    "globals": "^15.14.0",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.21.0",
    "vite": "^6.0.11"
  },
  "lint-staged": {
    "**/*.{ts,js}": [
      "eslint --fix"
    ],
    "**/*.{md,html,json,css}": [
      "prettier --write"
    ]
  }
}
