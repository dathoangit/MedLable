{
  "name": "medlabel",
  "version": "0.1.0",
  "private": true,
  "description": "API server for MedLabel: HIS patient lookup and Chrome extension update hosting.",
  "type": "module",
  "scripts": {
    "start": "tsx src/server/index.ts",
    "dev": "tsx watch src/server/index.ts",
    "build": "esbuild src/server/index.ts --bundle --platform=node --format=esm --outfile=dist/server.js --packages=external --sourcemap",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prettier": "prettier \"**/*.{md,html,json,css,ts}\" --write",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "lookup": "tsx scripts/lookup-ma-ho-so.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "dotenv": "^18.0.3",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "esbuild": "^0.25.8",
    "eslint": "^9.19.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.4.1",
    "globals": "^15.14.0",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.21.0"
  },
  "lint-staged": {
    "**/*.{ts,js}": [
      "eslint --fix"
    ],
    "**/*.{md,html,json,css}": [
      "prettier --write"
    ]
  }
}
