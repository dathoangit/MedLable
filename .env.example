# PostgreSQL (HIS) — copy to .env and fill in real values.
# Do not commit .env.
#
# The password that used to live in this file was a real secret and is still
# in git history. Rotate it on the database before production use
# (see deploy/rotate-db-password.sql), then put the new value only in .env.

PGHOST=172.16.16.23
PGPORT=5432
PGDATABASE=produce
PGUSER=his_stpaul
PGPASSWORD=change-me

# HTTP API (machines on the ward must be able to reach BIND_HOST).
PORT=8080
BIND_HOST=0.0.0.0
UPDATE_DIR=updates
RATE_LIMIT_PER_MINUTE=60

# Stability timeouts (ms). Keep STATEMENT_TIMEOUT_MS <= REQUEST_TIMEOUT_MS
# so hung HIS queries free the pool before the HTTP response times out.
STATEMENT_TIMEOUT_MS=8000
REQUEST_TIMEOUT_MS=10000
SHUTDOWN_DRAIN_MS=10000
